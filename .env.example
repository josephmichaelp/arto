# Region hosting Amplify dan backend (Singapura). Amplify tidak tersedia di ap-southeast-3.
AWS_REGION=ap-southeast-1

# Region panggilan Amazon Bedrock (Jakarta)
BEDROCK_REGION=ap-southeast-3

# Format: modelId@region dipisah koma. Kosong = C1,C2,C3 bawaan.
# AI_MODEL_CANDIDATES=amazon.nova-lite-v1:0@ap-southeast-3,apac.amazon.nova-lite-v1:0@ap-southeast-3,apac.amazon.nova-lite-v1:0@ap-southeast-1

# false memaksa kandidat C1 saja
AI_ALLOW_CROSS_REGION=true

# Batas permintaan AI per pengguna per jam
AI_RATE_LIMIT=30
